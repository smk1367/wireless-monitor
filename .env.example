SCAN_NETWORK=172.17.240.0/20
SSH_PORT=22
SSH_TIMEOUT=10
SCAN_WORKERS=40
RUN_INITIAL_SCAN=0

DASHBOARD_USER=admin
DASHBOARD_PASS=CHANGE_ME_NOW

# One legacy credential (optional)
SSH_USER=op
SSH_PASS=CHANGE_ME

# Up to 5 explicit credential pairs (add more in docker-compose if needed)
SSH_USER_1=op
SSH_PASS_1=CHANGE_ME
SSH_USER_2=
SSH_PASS_2=
SSH_USER_3=
SSH_PASS_3=
SSH_USER_4=
SSH_PASS_4=
SSH_USER_5=
SSH_PASS_5=

# Or JSON list, e.g.
# SSH_CREDENTIALS_JSON=[{"username":"op","password":"p1","id":"mt1"},{"username":"admin","password":"p2","id":"mt2"}]
